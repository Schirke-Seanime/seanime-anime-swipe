{
  "id": "anime-swipe",
  "name": "Anime Swipe",
  "version": "1.0.0",
  "manifestURI": "https://raw.githubusercontent.com/Schirke/seanime-anime-swipe/main/src/manifest.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Discover anime you haven't seen, one card at a time: swipe right to add to Planning, left to pass. Filter by genre and subgenre (Fantasy → Isekai).",
  "author": "Schirke",
  "icon": "https://raw.githubusercontent.com/Schirke/seanime-anime-swipe/main/src/icon.png",
  "website": "https://github.com/Schirke/seanime-anime-swipe",
  "lang": "en",
  "payloadURI": "https://raw.githubusercontent.com/Schirke/seanime-anime-swipe/main/src/AnimeSwipe.ts",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": [
        "anilist",
        "anilist-token",
        "database",
        "storage"
      ],
      "allow": {
        "networkAccess": {
          "allowedDomains": [
            "graphql.anilist.co"
          ]
        }
      }
    }
  }
}
